# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key — safe to expose in client bundles (NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY (API routes, never sent to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for AI plan generation and AI coach. Server-only.
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Secret key — SERVER ONLY
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Publishable key — safe for browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook secret — from Stripe dashboard Webhooks section
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs — create in Stripe dashboard, copy price IDs here
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_id
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_ELITE_MONTHLY=price_elite_monthly_id

# ─── App ──────────────────────────────────────────────────────────────────────
# Base URL for OAuth callbacks and Stripe redirects.
# Dev: http://localhost:3000  |  Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
